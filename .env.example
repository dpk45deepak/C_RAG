# Users provide Gemini API keys in the UI for each session; do not require GEMINI_API_KEY in production.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Tavily web fallback is supplied by users in the chat UI; do not configure a shared server-side key.
`